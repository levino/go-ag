{
  "name": "go-ag",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "install-typst": "test -x ./node_modules/.bin/typst || (curl -fsSL https://github.com/typst/typst/releases/latest/download/typst-x86_64-unknown-linux-musl.tar.xz -o /tmp/typst.tar.xz && tar -xf /tmp/typst.tar.xz -C /tmp/ && cp /tmp/typst-*/typst ./node_modules/.bin/)",
    "build": "npm run install-typst && astro build",
    "preview": "wrangler pages dev build --d1 DB",
    "check": "astro check && tsc -p functions"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@levino/shipyard-base": "^0.9.4",
    "@levino/shipyard-docs": "^0.9.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "wrangler": "^4.158.0"
  }
}
